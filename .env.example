OPENAI_API_KEY=sk-...
# Optional orchestrator LLM for `spec`/`stress` (OpenAI Responses API)
# REFLEX_LLM_MODEL=gpt-5   # optional: headless mode. Leave unset to let your coding agent write the spec
# Teacher model for the Decisions API (beta)
REFLEX_TEACHER_MODEL=gpt-6-luna
# Teacher pricing in USD per 1M tokens (used for cost estimates; set to the real numbers)
# Decisions API beta (Oct 2026): $0.10 / 1M input tokens, output not billed
REFLEX_PRICE_IN_PER_M=0.10
REFLEX_PRICE_OUT_PER_M=0.00
